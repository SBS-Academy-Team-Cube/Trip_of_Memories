  m_Script: {fileID: 11500000, guid: 5c90e929586dfb44a88d7ad29e45cb29, type: 3}
  m_Name: 0
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  Data:
  - Speaker: 
    Text: "\uC88B\uC544 \uC624\uB298\uC740 \uC5EC\uAE30\uB97C \uD55C\uBC88 \uAC00\uBCF4\uC790!"
  - Speaker: 
    Text: "\uB098\uC758 \uC9C1\uC5C5\uC740 \uBAA8\uD5D8\uAC00\uC774\uB2E4. \n\uC624\uB298\uB3C4
      \uD3C9\uC0C1\uC2DC\uC640 \uAC19\uC774 \uC0C8\uB85C\uC6B4 \uACF3\uC73C\uB85C
      \uD0D0\uD5D8\uC744 \uB098\uC130\uB2E4. \n\uADF8\uB9AC\uACE0, \uC808\uBCBD\uC744
      \uAC74\uB108\uAC00\uB824\uB358 \uC21C\uAC04 \uC608\uC0C1\uCE58 \uBABB\uD55C
      \uC0AC\uACE0\uAC00 \uC77C\uC5B4\uB0AC\uB2E4. \r\n"
  - Speaker: 
    Text: "\uC557! \uC73C\uC544\uC544\uC544\uC545"
  - Speaker: 
    Text: "\uC804\uB0A0 \uBE44\uAC00 \uC628 \uD0D3\uC778\uC9C0, \uC9C0\uBC18\uC774
      \uB9CE\uC774 \uC57D\uD574\uC9C4 \uC0C1\uD0DC\uC600\uB2E4. \n\uAC74\uB108\uD3B8
      \uC808\uBCBD\uC5D0 \uCC29\uC9C0\uD55C \uC21C\uAC04 \uC808\uBCBD \uB05D\uC774
      \uBB34\uB108\uC84C\uB2E4."
  - Speaker: 
    Text: "\uC5BC\uB9C8\uB098 \uAE30\uC808\uD574 \uC788\uC5C8\uC744\uAE4C \uB098\uB294
      \uB208\uC744 \uB5B4\uB2E4. \n\uADF8\uB9AC\uACE0 \uB098\uB294 \uC544\uBB34\uAC83\uB3C4
      \uC548 \uBCF4\uC774\uB294 \n\uC5B4\uB450\uC6B4 \uACF5\uAC04\uC5D0 \uC788\uB294
      \uAC83 \uAC19\uC740 \uAE30\uBD84\uC774\uC5C8\uB2E4."

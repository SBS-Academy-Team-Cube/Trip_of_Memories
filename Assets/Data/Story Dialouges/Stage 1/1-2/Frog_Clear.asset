  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c90e929586dfb44a88d7ad29e45cb29, type: 3}
  m_Name: Frog_Clear
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  Data:
  - Speaker: "\uC758\uBB38\uC758 \uAC1C\uAD6C\uB9AC"
    Text: "\uB108 \uB0B4\uAC00 \uB204\uAD70\uC9C0 \uAE30\uC5B5 \uC548\uB098\uB2C8??"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC804\uD600..."
  - Speaker: "\uC758\uBB38\uC758 \uAC1C\uAD6C\uB9AC"
    Text: "\uB098 \uB9D0\uC774\uC57C \uB108\uAC00 \uC5B4\uB838\uC744 \uB54C \uB4B7\uC0B0\uC5D0\uC11C
      \uC7A1\uC558\uB358 \uC62C\uCC59\uC774\uC57C, \n\uB108\uAC00 \uAC1C\uAD6C\uB9AC
      \uB420\uB54C\uAE4C\uC9C0 \uB098 \uD0A4\uC6E0\uC5C8\uC796\uC544"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC544 \uB9DE\uB2E4!! \n\uADF8\uB798, \uC5B4\uB838\uC744 \uB54C \uB4B7\uC0B0\uC5D0\uC11C
      \uC62C\uCC59\uC774\uB97C \uC7A1\uC558\uB358 \uC801\uC774 \uC788\uC5C8\uC5B4"
  - Speaker: "\uC758\uBB38\uC758 \uAC1C\uAD6C\uB9AC"
    Text: "\uB108 \uADF8\uB54C \uC5C4\uCCAD \uAC1C\uAD6C\uC7C1\uC774\uC600\uC5C8\uC5B4,
      \n\uB4B7\uC0B0 \uC5EC\uAE30\uC800\uAE30 \uD0D0\uD5D8\uD558\uB294\uAC78 \uC88B\uC544\uD588\uC5C8\uB2E4\uACE0"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC544.. \uBB54\uAC00 \uAE30\uC5B5 \uB0A0\uB824\uB294 \uAC83 \uAC19\uAE30\uB3C4
      \uD558\uACE0"
  - Speaker: "\uC758\uBB38\uC758 \uAC1C\uAD6C\uB9AC"
    Text: "\uC870\uAE08\uC529 \uAE30\uC5B5\uC774 \uB3CC\uC544\uC624\uB294 \uAC83
      \uAC19\uAD6C\uB098, \n\uC544\uB9C8 \uC5EC\uAE34 \uB108\uC758 \uAE30\uC5B5\uB4E4\uC774
      \uB2E8\uD3B8\uB2E8\uD3B8 \uC774\uB8E8\uC5B4\uC9C4 \uACF5\uAC04\uC77C\uAC70\uC57C"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC5EC\uAE38 \uC9C0\uB098\uAC00\uB2E4\uBCF4\uBA74 \uC5EC\uAE30\uAC00 \uC5B4\uB514\uC778\uC9C0
      \uC54C \uC218 \uC788\uACA0\uC9C0?"
  - Speaker: "\uC758\uBB38\uC758 \uAC1C\uAD6C\uB9AC"
    Text: "\uADF8\uAC74 \uB108 \uD558\uAE30 \uB098\uB984\uC774\uACA0\uC9C0?, \uC554\uD2BC
      \uC751\uC6D0\uD560\uAC8C. \n\uADF8\uB9AC\uACE0 \uC774\uB54C \uACE0\uB9C8\uC6E0\uC5B4"

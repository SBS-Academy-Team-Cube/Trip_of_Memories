  m_Script: {fileID: 11500000, guid: 5c90e929586dfb44a88d7ad29e45cb29, type: 3}
  m_Name: Paper_Plane
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  Data:
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC774 \uC885\uC774 \uBE44\uD589\uAE30 \uC5B4\uB514\uC120\uAC00 \uBCF8\uC801\uC774
      \uC788\uB294\uB370"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC5EC\uAE30 \uB0B4 \uC774\uB984\uC774 \uC801\uD600 \uC788\uC796\uC544!"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC774 \uAE00\uC528 \uB0B4\uAC00 \uC5B4\uB838\uC744 \uB54C \uC801\uC5C8\uB358
      \uAC83 \uAC19\uC740\uB370, \uC7A0\uAE50 \uC61B\uB0A0\uC5D0 \uC9D1 \uC625\uC0C1\uC5D0\uC11C,
      \uC885\uC774 \uBE44\uD589\uAE30\uB97C \uC811\uC5B4\uAC00\uC9C0\uACE0 \uB4B7\uC0B0\uC5D0
      \uBA87\uBC88 \uB0A0\uB838\uC5C8\uC5C8\uC5B4"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uADF8\uB9AC\uACE0 \uC774 \uBE44\uD589\uAE30\uB97C \uCC3E\uC73C\uB7EC
      \uB4B7\uC0B0\uC5D0 \uC885\uC885 \uAC00\uACE4 \uD588\uC5C8\uC9C0"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uB09C \uADF8\uB7EC\uBA74\uC11C \uC810\uC810 \uBB34\uC5B8\uAC00\uB97C
      \uCC3E\uC73C\uB7EC \uB2E4\uB2C8\uB294 \uBAA8\uD5D8\uC744 \uC88B\uC544\uD558\uAC8C
      \uB418\uC5C8\uC744\uC9C0\uB3C4 \uBAB0\uB77C"

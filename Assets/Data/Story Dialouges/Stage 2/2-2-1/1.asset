--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c90e929586dfb44a88d7ad29e45cb29, type: 3}
  m_Name: 1
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  Data:
  - Speaker: "\uD669\uAE08\uBC15\uC950"
    Text: "\uC548\uB155?"
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC5B4... \uC7A0\uAE50\uB9CC \uC5B4\uB514\uC11C \uBCF8 \uAC83 \uAC19\uC740\uB370?"
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uD669\uAE08\uBC15\uC950"
    Text: "\uB108\uAC00 \uB0A0 \uCC3E\uC544\uB0B8 \uCCAB \uBC88\uC9F8 \uBAA8\uD5D8\uAC00\uC57C"
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC0DD\uAC01\uB0AC\uC5B4. \uB0B4\uAC00 \uC720\uBA85\uD55C \uBAA8\uD5D8\uAC00\uAC00
      \uB41C \uACC4\uAE30"
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "(\uADF8\uB798, \uC774 \uC720\uC801\uC5D0\uC11C \uCC98\uC74C\uC73C\uB85C
      \uD669\uAE08\uBC15\uC950\uAC00 \uC11C\uC2DD\uD55C\uB2E4\uB294\uAC78 \uCC3E\uC544\uB0C8\uC9C0) "
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uD669\uAE08\uBC15\uC950"
    Text: "\uAD49\uC7A5\uD788 \uC5B4\uB461\uACE0 \uCC3E\uAE30 \uD798\uB4E0 \uACF3\uC5D0
      \uC788\uC5C8\uC744\uD150\uB370 \uC6A9\uCF00 \uC798 \uCC3E\uC544\uB0C8\uB354\uB77C\uACE0"
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "(\uB0B4\uAC00 \uB204\uAD6C\uC778\uC9C0 \uC870\uAE08\uC529 \uC54C\uC544\uAC00\uB294
      \uAC83 \uAC19\uC740 \uAE30\uBD84\uC774\uB2E4. \uB09C \uC774 \uC77C\uC744 \uACC4\uAE30\uB85C
      \uC720\uBA85\uD55C \uBAA8\uD5D8\uAC00\uAC00 \uB418\uC5C8\uC5B4)"
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uD669\uAE08\uBC15\uC950"
    Text: "\uC65C \uAC11\uC790\uAE30 \uBA4D\uD558\uB2C8 \uC11C\uC788\uB294\uAC70\uC57C?"
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC544.. \uC544\uB0D0, \uB9CC\uB098\uC11C \uBC18\uAC00\uC6E0\uC5B4, \uAE30\uB150\uC73C\uB85C
      \uC0AC\uC9C4\uCC0D\uACE0 \uCD9C\uAD6C\uB97C \uCC3E\uC544\uC73C\uB7EC \uAC00\uBCFC\uAC8C"
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uCE74\uBA54\uB77C"
    Text: "\uCC30\uCE75!"
    NoEffect: 1
    SFX: {fileID: 8300000, guid: 40ef6fa93b5b7164883857e528f8eb87, type: 3}
  - Speaker: "\uD669\uAE08\uBC15\uC950"
    Text: "\uC6B0\uC653 \uAE5C\uC9DD\uC774\uC57C"
    NoEffect: 0
    SFX: {fileID: 0}
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uACE0\uB9C8\uC6E0\uC5B4 \uB098\uC911\uC5D0 \uB610 \uBCF4\uC790~"
    NoEffect: 0
    SFX: {fileID: 0}

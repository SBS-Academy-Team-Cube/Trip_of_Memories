  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c90e929586dfb44a88d7ad29e45cb29, type: 3}
  m_Name: 1
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  Data:
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC6B0\uC557!!"
  - Speaker: "\uC694\uC815"
    Text: "\uAE5C\uC9DD\uC774\uC57C!"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC774\uCABD\uC774 \uD560 \uB9D0\uC774\uC57C, \uB10C \uC5EC\uAE30\uC11C
      \uBB50 \uD558\uB294 \uAC70\uB2C8?"
  - Speaker: "\uC694\uC815"
    Text: "\uB098 \uB9D0\uC774\uC57C? \uC815\uD655\uD558\uAC8C \uB9D0\uD558\uBA74
      \uB204\uAD70\uAC00\uC758 \uB9C8\uC74C\uC774 \uD615\uC0C1\uD654 \uB41C \uC874\uC7AC\uB77C\uACE0
      \uD560\uAE4C\uB098?"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uC774\uD574\uAC00 \uC548\uB418\uB294\uB370\u2026 \uBB34\uC2A8 \uC18C\uB9B4
      \uD558\uB294\uAC70\uB2C8?"
  - Speaker: "\uC694\uC815"
    Text: "\uC5EC\uAE30\uAC00 \uC5B4\uB514\uC778\uC9C0 \uC54C\uACE0 \uC788\uB2C8?"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uB0B4\uAC00 \uC815\uC2DD\uC73C\uB85C \uBAA8\uD5D8\uAC00\uAC00 \uB418\uACE0
      \uCCAB \uBAA8\uD5D8\uC744 \uD558\uB294 \uACF3 \uC544\uB2C8\uC57C?"
  - Speaker: "\uC694\uC815"
    Text: "\uADF8\uB7F0 \uB108\uC758 \uB9C8\uC74C\uC758 \uD615\uC0C1\uD654 \uB418\uC11C
      \uB0B4\uAC00 \uB098\uD0C0\uB09C\uAC70\uC57C, \uB108\uB294 \uBAA8\uD5D8 \uCCAB
      \uC5EC\uD589 \uB54C \uAD49\uC7A5\uD788 \uC124\uB808\uD558\uACE0 \uB450\uADFC\uAC70\uB838\uC5C8\uC9C0."
  - Speaker: "\uC694\uC815"
    Text: "\uADF8\uB7F0 \uB108\uC758 \uB9C8\uC74C\uC18D\uC5D0\uC11C \uD0DC\uC5B4\uB0AC\uC5B4"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: "\uB9DE\uC544 \uADF8\uB7AC\uB358 \uAC83 \uAC19\uC544, \uADFC\uB370 \uADF8\uAC8C
      \uAC00\uB2A5\uD574? \uC694\uC815 \uAC19\uC740\uAC74 \uD604\uC2E4\uC5D0\uC11C.."
  - Speaker: "\uC694\uC815"
    Text: "\uADF8\uC57C \uC5EC\uAE34 \uD604\uC2E4\uC774 \uC544\uB2C8\uB2C8\uAE4C"
  - Speaker: "\uD50C\uB808\uC774\uC5B4"
    Text: ???
  - Speaker: "\uC694\uC815"
    Text: "\uC544, \uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC57C"

  m_Name: Tutorial 1-1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Dialogues:
  - "<\uC774\uB3D9>\nW, A, S, D \uB97C \uB204\uB974\uBA74 \uC774\uB3D9\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4\nShift\uB97C \uAC19\uC774 \uB204\uB974\uBA74 \uB2EC\uB9B4
    \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  - "<\uC810\uD504>\nSpace \uD0A4\uB97C \uB20C\uB7EC \uC810\uD504\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  - "<\uBCBD\uC624\uB974\uAE30>\n\uC77C\uC815 \uB192\uC774\uC758 \uBCBD\uC740 \uC810\uD504
    \uB3C4\uC911 Space \uD0A4\uB97C \uD55C \uBC88 \uB354 \uB20C\uB7EC \uC62C\uB77C\uAC08
    \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  - "<\uC544\uC774\uD15C \uB0B4\uB824\uB193\uAE30>\n\uC544\uC774\uD15C\uC744 \uB4E4\uACE0
    \uC788\uC744 \uB54C E \uD0A4\uB97C \uB20C\uB7EC \uB0B4\uB824\uB193\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4\n\uC54C\uB9DE\uC740 \uC544\uC774\uD15C\uC744 \uC62C\uB824\uB450\uC5B4
    \uBB38\uC744 \uC5F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  - "<\uC544\uC774\uD15C \uC9D1\uAE30>\n\uC544\uC774\uD15C\uACFC \uC77C\uC815 \uAC70\uB9AC
    \uAC00\uAE4C\uC6CC\uC84C\uC744 \uB54C E \uD0A4\uB97C \uB20C\uB7EC \uC544\uC774\uD15C\uC744
    \uC9D1\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
  - "<\uBC27\uC904 \uC624\uB974\uAE30>\nE \uD0A4\uB97C \uB20C\uB7EC \uBC27\uC904\uC744
    \uD0C0\uACE0 \uC624\uB974 \uB0B4\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n\uBC27\uC904\uC5D0
    \uB9E4\uB2EC\uB9B0 \uC0C1\uD0DC\uC5D0\uC11C Space \uD0A4\uB97C \uB20C\uB7EC \uC810\uD504\uD558\uC5EC
    \uBC27\uC904\uC744 \uB193\uC2B5\uB2C8\uB2E4"
  - "<\uC801 \uACF5\uACA9\uD558\uAE30>\n1\uBC88 \uD0A4\uB97C \uB20C\uB7EC \uBC8C\uB808
    \uD1F4\uCE58 \uC2A4\uD504\uB808\uC774\uB97C \uAEBC\uB0B4\uAC70\uB098 \uB123\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC2A4\uD504\uB808\uC774\uB97C \uC190\uC5D0
    \uC954 \uCC44\uB85C F \uD0A4\uB97C \uB20C\uB7EC \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8"
